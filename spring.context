package com.example.vm1;

import org.apache.catalina.core.ApplicationContext;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.support.ClassPathXmlApplicationContext;

@SpringBootApplication
public class Vm1Application {

	public static void main(String[] args) {
        ApplicationContext context= ClassPathXmlApplicationContext("ApplicationContext.Xml")
                NotificationProvider notificationProvider=context.getbeans("Notification",SmsProvider.class)
                notificationProvider.sendNotification();
		}

}
